{
  "manifest_version": 2,
  "id": "blackbee114514.deepseek-search",
  "version": "1.0.0",
  "name": "DeepSeek 联网搜索与网页抓取",
  "description": "为 MaiBot 接入 DeepSeek Search / Fetch API：LLM 工具 search_web 与 fetch_webpage、/search 与 /fetch 命令、插件间 API 以及首页状态卡片，内置限速、缓存与脱敏日志。",
  "author": {
    "name": "BlackBee114514",
    "url": "https://space.bilibili.com/1041748349"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/Blackwindy2333/DeepSeekSearchPlugin",
    "issues": "https://github.com/Blackwindy2333/DeepSeekSearchPlugin/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.14.0",
    "max_version": "999.999.999"
  },
  "capabilities": [],
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "search"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
